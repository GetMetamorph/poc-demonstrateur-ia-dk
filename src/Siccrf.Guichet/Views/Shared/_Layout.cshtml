@inject CompteDemo Compte
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Guichet SICCRF</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/fiche.js" asp-append-version="true" defer></script>
    <script src="~/js/conversation.js" asp-append-version="true" type="module"></script>
</head>
<body>
    <header class="app-header">
        <nav class="container-fluid navbar" aria-label="Navigation principale">
            <a href="/" class="brand"><span class="brand-mark" aria-hidden="true">S</span><span>Guichet SICCRF</span></a>
            <form asp-controller="ComptesDemo" asp-action="Changer" method="post" class="role-switch">
                <span class="role-label">Mode démo</span>
                <button name="role" value="demandeur" class="btn btn-sm @(!Compte.EstAdministrateur ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@((!Compte.EstAdministrateur).ToString().ToLowerInvariant())">Demandeur</button>
                <button name="role" value="administrateur" class="btn btn-sm @(Compte.EstAdministrateur ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@(Compte.EstAdministrateur.ToString().ToLowerInvariant())">Administrateur</button>
            </form>
        </nav>
    </header>
    <main class="container-fluid app-main" id="contenu">
        @RenderBody()
    </main>
    <footer class="app-footer">Mode démo · Comptes fictifs · Données fictives uniquement · Sans authentification réelle</footer>
</body>
</html>
